RewriteEngine On

# Custom 404 page
ErrorDocument 404 /404.php

# Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Friendly URLs without extensions (now routed through structured /routes folders)
RewriteRule ^login$ routes/auth/login.php [L]
RewriteRule ^signup$ routes/auth/signup.php [L]
RewriteRule ^logout$ routes/auth/logout.php [L]
RewriteRule ^dashboard$ routes/auth/dashboard.php [L]
RewriteRule ^portal$ routes/auth/portal.php [L]

RewriteRule ^admin-login$ routes/admin/login.php [L]
RewriteRule ^admin$ routes/admin/admin.php [L]
RewriteRule ^admin-theme$ routes/admin/theme.php [L]
RewriteRule ^admin-settings$ routes/admin/settings.php [L]
RewriteRule ^admin-captcha$ routes/admin/captcha.php [L]

RewriteRule ^learn-more$ routes/public/learn_more.php [L]
RewriteRule ^support$ routes/public/support.php [L]

RewriteRule ^install$ install.php [L]