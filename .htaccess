RewriteEngine On

# Custom 404 page
ErrorDocument 404 /404.php

# Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Friendly URLs without extensions
RewriteRule ^login$ login.php [L]
RewriteRule ^signup$ signup.php [L]
RewriteRule ^admin$ admin.php [L]
RewriteRule ^admin-theme$ admin-theme.php [L]
RewriteRule ^admin-settings$ admin-settings.php [L]
RewriteRule ^admin-captcha$ admin-captcha.php [L]
RewriteRule ^portal$ portal.php [L]
RewriteRule ^user-theme-save$ user-theme-save.php [L]
RewriteRule ^dashboard$ dashboard.php [L]
RewriteRule ^learn-more$ learn-more.php [L]
RewriteRule ^support$ support.php [L]
RewriteRule ^logout$ logout.php [L]
RewriteRule ^install$ install.php [L]